{
  "name": "ngx-resizable-demo",
  "version": "1.0.4",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build_lib": "ng build ngx-resizable",
    "copy-license": "cp LICENSE.txt dist/ngx-resizable",
    "copy-readme": "cp README.md dist/ngx-resizable",
    "copy-files": "npm run copy-license && npm run copy-readme",
    "npm_pack": "cd dist/ngx-resizable && npm pack",
    "demo2docs": "ng build --base-href https://3dgenomes.github.io/ngx-resizable/ --output-path docs",
    "package": "npm run build_lib && npm run copy-files && npm run npm_pack && npm run demo2docs",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
    "@3dgenomes/ngx-resizable": "^1.8.1",
    "@angular/animations": "^15.2.10",
    "@angular/common": "^15.2.10",
    "@angular/compiler": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@angular/platform-browser": "^15.2.10",
    "@angular/platform-browser-dynamic": "^15.2.10",
    "@angular/router": "^15.2.10",
    "core-js": "^2.6.9",
    "rxjs": "~6.6.7",
    "zone.js": "~0.11.8"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^15.2.11",
    "@angular-devkit/build-ng-packagr": "^0.1002.4",
    "@angular/cli": "^15.2.11",
    "@angular/compiler-cli": "^15.2.10",
    "@angular/language-service": "^15.2.10",
    "@types/jasmine": "^3.3.16",
    "@types/jasminewd2": "^2.0.6",
    "@types/node": "^11.13.18",
    "angular-cli-ghpages": "^0.5.3",
    "codelyzer": "^5.0.1",
    "jasmine-core": "~3.5.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "ng-packagr": "^15.2.2",
    "protractor": "~7.0.0",
    "ts-node": "^8.3.0",
    "tsickle": "^0.39.1",
    "tslib": "^2.0.0",
    "tslint": "~6.1.0",
    "typescript": "~4.9.5"
  }
}